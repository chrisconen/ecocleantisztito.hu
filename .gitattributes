# The Pages artifact is verified by SHA-256; checkout must preserve exact bytes.
/release/** -text
/release-support/release-manifest.json -text
/release-support/release-verification.json -text
# Approved generated demos and their immutable baselines also have manifest hashes.
/demo/*.html -text
/demo/mediterranean/*.json -text
/demo/mediterranean/baseline/*.html -text
# Immutable widget overlay provenance is also verified byte-for-byte in CI.
/release-support/material-widget-overlay.json -text
/release-support/material-widget-baseline/*.json -text
/release-support/copy-tone/*.json -text
/release-support/studio/*.json -text
/release-support/studio/baseline/*.html -text
/demo/studio/*.json -text
/demo/studio/** -text
/release-support/studio/*.mjs -text
